    <decisions>
        <description>If: the record now and previously were in &quot;Dispatched&quot; status, 
    the new start date is later than the previous start date then it has been rescheduled, 
    email has not already been sent for this service</description>
        <name>Was_service_rescheduled</name>
        <label>Was service rescheduled?</label>
        <locationX>732</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>All criteria did not qualify for email automation</defaultConnectorLabel>
        <rules>
            <name>RescheduledService</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Dispatched</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Dispatched</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.SchedStartTime</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.SchedStartTime</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SchedStartTime</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>TodayNow</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Date_of_Automated_Service_Email_Sent__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Service_was_rescheduled</targetReference>
            </connector>
            <label>RescheduledService</label>
        </rules>
        <rules>
            <name>Service_either_planned_or_reactive</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Dispatched</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.SchedStartTime</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.SchedStartTime</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Date_of_Automated_Service_Email_Sent__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Get_Work_Orders_from_Service_Appointment</targetReference>
            </connector>
            <label>Service either planned or reactive</label>
        </rules>
    </decisions>
