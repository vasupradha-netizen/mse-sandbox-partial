<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Final_Email</name>
        <label>Send Final Email</label>
        <locationX>50</locationX>
        <locationY>1200</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$Record.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <stringValue>OrgWideEmailAddress</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderAddress</name>
            <value>
                <stringValue>sales@mainspringenergy.com</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>ttEmailSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>ttEmailBody</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>assInitTable</name>
        <label>assInitTable</label>
        <locationX>50</locationX>
        <locationY>684</locationY>
        <assignmentItems>
            <assignToReference>vaEmailTableBody</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ttTableandHeader</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>LoopLeads</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>adds a row to the table, vaRowNumber is used to set cell color</description>
        <name>asstBuildTable</name>
        <label>asstBuildTable</label>
        <locationX>138</locationX>
        <locationY>900</locationY>
        <assignmentItems>
            <assignToReference>vaEmailTableBody</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>ttTableRow</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>vaRowNumber</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>LoopLeads</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>asstCloseTable</name>
        <label>asstCloseTable</label>
        <locationX>50</locationX>
        <locationY>1092</locationY>
        <assignmentItems>
            <assignToReference>vaEmailTableBody</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>&lt;/table&gt;</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>vaEmailTableBody</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>&lt;/div&gt;</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Final_Email</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>LeadCont</name>
        <label>LeadCont</label>
        <locationX>182</locationX>
        <locationY>360</locationY>
        <assignmentItems>
            <assignToReference>vaLeadCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>getStalledLeads</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>decGotLeads</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>sortLeads</name>
        <elementSubtype>SortCollectionProcessor</elementSubtype>
        <label>sortLeads</label>
        <locationX>50</locationX>
        <locationY>576</locationY>
        <collectionProcessorType>SortCollectionProcessor</collectionProcessorType>
        <collectionReference>getStalledLeads</collectionReference>
        <connector>
            <targetReference>assInitTable</targetReference>
        </connector>
        <sortOptions>
            <doesPutEmptyStringAndNullFirst>false</doesPutEmptyStringAndNullFirst>
            <sortField>MQL_Date__c</sortField>
            <sortOrder>Asc</sortOrder>
        </sortOptions>
    </collectionProcessors>
    <decisions>
        <name>decGotLeads</name>
        <label>decGotLeads</label>
        <locationX>182</locationX>
        <locationY>468</locationY>
        <defaultConnectorLabel>No Leads</defaultConnectorLabel>
        <rules>
            <name>Onwer_Has_Leads</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>vaLeadCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>sortLeads</targetReference>
            </connector>
            <label>Onwer Has Leads</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>Table row background color: odd rows = no color</description>
        <name>ffBackgroundColor</name>
        <dataType>String</dataType>
        <expression>IF(MOD({!vaRowNumber},2) = 0, &quot;#f2f2f2&quot;, &quot;#ffffff&quot;)</expression>
    </formulas>
    <formulas>
        <name>ffBaseURL</name>
        <dataType>String</dataType>
        <expression>Left({!$Api.Enterprise_Server_URL_190},(find(&apos;/services&apos;,{!$Api.Enterprise_Server_URL_190})))</expression>
    </formulas>
    <interviewLabel>2 Day Lead Assignment Email Reminder {!$Flow.CurrentDateTime}</interviewLabel>
    <label>2 Day Lead Assignment Email Reminder</label>
    <loops>
        <description>loops over the sorted leads owned by users</description>
        <name>LoopLeads</name>
        <label>LoopLeads</label>
        <locationX>50</locationX>
        <locationY>792</locationY>
        <collectionReference>getStalledLeads</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>asstBuildTable</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>asstCloseTable</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Leads that have been stalled at MQL for more than 14 days.</description>
        <name>getStalledLeads</name>
        <label>getStalledLeads</label>
        <locationX>182</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>LeadCont</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Marketing Qualified</stringValue>
            </value>
        </filters>
        <filters>
            <field>Lead_Assignment_Days__c</field>
            <operator>EqualTo</operator>
            <value>
                <numberValue>2.0</numberValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Lead</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>getStalledLeads</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsActive</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>User</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2024-05-05</startDate>
            <startTime>10:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Obsolete</status>
    <textTemplates>
        <name>ttEmailBody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Marketing web form inquiries have been assigned to you.&amp;nbsp;The expectation of the prospect is that we will likely get back to them within 24 business hours or maximum of 2 business days.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;{!vaEmailTableBody}&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <description>the subject for the email</description>
        <name>ttEmailSubject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>New Lead Assignment Reminder:  {!$Flow.CurrentDate}</text>
    </textTemplates>
    <textTemplates>
        <name>ttTableandHeader</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>&lt;div style=&quot;max-width:800px;&quot;&gt;
&lt;table style=&quot;border:1px solid black;width:100%;&quot;&gt;
&lt;tr&gt;
&lt;th style=&quot;border-bottom: 1px solid black; text-align:left;&quot;&gt;Lead Name&lt;/th&gt;
&lt;th style=&quot;border-bottom: 1px solid black; text-align:left;&quot;&gt;Company&lt;/th&gt;
&lt;th style=&quot;border-bottom: 1px solid black; text-align:left;&quot;&gt;Created Date&lt;/th&gt;
&lt;th style=&quot;border-bottom: 1px solid black; text-align:left;&quot;&gt;Status&lt;/th&gt;
&lt;th style=&quot;border-bottom: 1px solid black; text-align:left;&quot;&gt;Days in MQL&lt;/th&gt;
&lt;/tr&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>ttTableRow</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>&lt;tr style=&quot;background-color: {!ffBackgroundColor}; border: 1px solid {!ffBackgroundColor};&quot;&gt;
&lt;td style=&quot;padding:2px;&quot;&gt;&lt;a href=&quot;{!ffBaseURL}{!LoopLeads.Id}&quot;&gt;{!LoopLeads.Name}&lt;/a&gt;&lt;/td&gt;
&lt;td style=&quot;padding:2px;&quot;&gt;{!LoopLeads.Company}&lt;/td&gt;
&lt;td style=&quot;padding:2px; min-width:140px;&quot;&gt;{!LoopLeads.CreatedDate}&lt;/td&gt;
&lt;td style=&quot;padding:2px;&quot;&gt;{!LoopLeads.Status}&lt;/td&gt;
&lt;td style=&quot;padding:2px;&quot;&gt;{!LoopLeads.Delta_Days_MQL_to_Working__c}&lt;/td&gt;
&lt;/tr&gt;</text>
    </textTemplates>
    <variables>
        <name>vaEmailTableBody</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>prevents sending an email with no value.</description>
        <name>vaLeadCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <description>add table stripes - starting with row 1 (odd) = no background</description>
        <name>vaRowNumber</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>1.0</numberValue>
        </value>
    </variables>
</Flow>
