<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Has_Close_Date_Changed</name>
        <label>Has Close Date Changed?</label>
        <locationX>601</locationX>
        <locationY>506</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Closed_Date_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CloseDate</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Sites_Expected_Delivery_Data</targetReference>
            </connector>
            <label>Yes-Close Date Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Financier_Changed</name>
        <label>Has Financier Changed?</label>
        <locationX>596</locationX>
        <locationY>189</locationY>
        <defaultConnector>
            <targetReference>Has_Close_Date_Changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Financier_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Financier__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Sites_Financier</targetReference>
            </connector>
            <label>Yes-Financier Changed</label>
        </rules>
    </decisions>
    <description>When information changes on Opportunity update related Sites</description>
    <environments>Default</environments>
    <formulas>
        <name>CloseDatePlus9Months</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!$Record.CloseDate}, 9)</expression>
    </formulas>
    <interviewLabel>Opportunity - Update Sites {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Update Sites</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Sites_Expected_Delivery_Data</name>
        <label>Update Sites - Expected Delivery Data</label>
        <locationX>901</locationX>
        <locationY>497</locationY>
        <inputAssignments>
            <field>Expected_Delivery_Date__c</field>
            <value>
                <elementReference>CloseDatePlus9Months</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Sites__r</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Sites_Financier</name>
        <label>Update Sites - Financier</label>
        <locationX>825</locationX>
        <locationY>111</locationY>
        <connector>
            <targetReference>Has_Close_Date_Changed</targetReference>
        </connector>
        <inputAssignments>
            <field>Financier__c</field>
            <value>
                <elementReference>$Record.Financier__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Sites__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>68</locationY>
        <connector>
            <targetReference>Has_Financier_Changed</targetReference>
        </connector>
        <filterFormula>ISNEW() ||  ISCHANGED({!$Record.Financier__c}) || ISCHANGED({!$Record.CloseDate})</filterFormula>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
