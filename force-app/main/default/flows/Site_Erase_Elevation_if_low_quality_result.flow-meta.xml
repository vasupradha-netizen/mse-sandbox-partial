<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <interviewLabel>Site - Erase Elevation if low quality result {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Site - Erase Elevation if low quality result</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>wipe_elevation_lat_and_long</name>
        <label>wipe elevation, lat and long</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Elevation__c</field>
        </inputAssignments>
        <inputAssignments>
            <field>Geolocation__Latitude__s</field>
        </inputAssignments>
        <inputAssignments>
            <field>Geolocation__Longitude__s</field>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>wipe_elevation_lat_and_long</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Elevation__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Elevation__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <numberValue>3236.0</numberValue>
            </value>
        </filters>
        <filters>
            <field>Elevation__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <numberValue>3237.0</numberValue>
            </value>
        </filters>
        <object>Sites__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
