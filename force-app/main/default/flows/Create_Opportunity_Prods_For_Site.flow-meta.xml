    <description>This is a subflow that can create Opportunity Products for a Site when passed the following parameters:
What is the number of units at this Site?
Hydrogen Kit
What is the LGEN Model for this Site?
What is the hardware price per kW for this site?
What is the EPC services price for this Site?
EDS-4796</description>
    <environments>Default</environments>
    <formulas>
        <name>CalculatedBUKPrice</name>
        <dataType>Currency</dataType>
        <expression>{!GetPriceBookEntryId.Product2.Model_kW__c}*{!NumberOfUnitsAtSite}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CalculatedEPCPrice</name>
        <dataType>Currency</dataType>
        <expression>{!GetPriceBookEntryId.Product2.Model_kW__c}*{!EPC_Price}*{!NumberOfUnitsAtSite}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CalculatedReferralFee</name>
        <dataType>Currency</dataType>
        <expression>{!GetPriceBookEntryId.Product2.Model_kW__c}*{!ReferralFee}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CalculatedSalestaxrate</name>
        <dataType>Currency</dataType>
        <expression>{!CalculatedTotalSize}*({!SalesTaxRate}/100)*{!Hardware_price_per_kW_for_this_site}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CalculatedTotalSize</name>
        <dataType>Number</dataType>
        <expression>{!GetPriceBookEntryId.Product2.Model_kW__c}*{!NumberOfUnitsAtSite}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CalculatedUnitProce</name>
        <dataType>Currency</dataType>
        <expression>{!GetPriceBookEntryId.Product2.Model_kW__c}*{!Hardware_price_per_kW_for_this_site}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CalculatedZCFPrice</name>
        <dataType>Currency</dataType>
        <expression>{!NumberOfUnitsAtSite}*{!GetPriceBookEntryId.Product2.Model_kW__c}*{!ZCFkWPrice}</expression>
        <scale>2</scale>
    </formulas>
