    <decisions>
        <description>If the record now and previously were in &quot;Dispatched&quot; status and the new start date is later than the previous start date then it has been rescheduled</description>
        <name>Was_service_rescheduled</name>
        <label>Was service rescheduled?</label>
        <locationX>732</locationX>
        <locationY>1247</locationY>
        <defaultConnectorLabel>Do nothing</defaultConnectorLabel>
        <rules>
            <name>RescheduledService</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Dispatched</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.SchedStartTime</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.SchedStartTime</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SchedStartTime</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>TodayNow</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Service_was_rescheduled</targetReference>
            </connector>
            <label>RescheduledService</label>
        </rules>
        <rules>
            <name>Service_either_planned_or_reactive</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Dispatched</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.SchedStartTime</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.SchedStartTime</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Work_Orders_from_Service_Appointment</targetReference>
            </connector>
            <label>Service either planned or reactive</label>
        </rules>
    </decisions>
    <description>MS FSM Automatic Service Email sent on dispatched or reschedule - added primary and secondary contact types, automation date stamp. Adding Customer Success Manager and logic to account for removing duplicate email addrs. Added new scheduling logic to check same day. Service notification string to be saved onto Service Appointment, check if customer has been notified before</description>
    <environments>Default</environments>
    <formulas>
        <name>CheckIfCurrentService</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.SchedStartTime} &gt;= DATETIMEVALUE(TODAY())</expression>
    </formulas>
    <formulas>
        <name>DateBefore</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record__Prior.SchedStartTime})</expression>
    </formulas>
    <formulas>
        <name>DateNew</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.SchedStartTime})</expression>
    </formulas>
    <formulas>
        <description>Formula to extract date of service</description>
        <name>DateOfService</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.SchedStartTime})</expression>
    </formulas>
    <formulas>
        <name>MainspringRecipients</name>
        <dataType>String</dataType>
        <expression>&quot;kyle.reilly@mainspringenergy.com,&quot; &amp;  {!CSM_Recipient_Email} &amp; {!$User.Email}</expression>
    </formulas>
    <formulas>
        <description>Is this a planned or reactive service?</description>
        <name>PlannedOrReactiveService</name>
        <dataType>String</dataType>
        <expression>IF( {!CountOfReactiveWOLIs} &gt; 0, &quot;reactive&quot;, &quot;planned&quot;)</expression>
    </formulas>
    <formulas>
        <description>Text(Month(DATEVALUE({!$Record__Prior.SchedStartTime}))) &amp;&quot; &quot; &amp; Text(Day(DATEVALUE({!$Record__Prior.SchedStartTime})))&amp; &quot;, &quot; &amp; Text(Year(DATEVALUE({!$Record__Prior.SchedStartTime})))</description>
        <name>PriorDateOfService</name>
        <dataType>String</dataType>
        <expression>Text(DATEVALUE({!$Record__Prior.SchedStartTime}))</expression>
    </formulas>
    <formulas>
        <name>ServiceDatesNotificationString</name>
        <dataType>String</dataType>
        <expression>{!$Record.Service_Email_Dates_Notified__c} &amp; {!TodayDate}</expression>
    </formulas>
    <formulas>
        <name>ServiceStatusSnippet</name>
        <dataType>String</dataType>
        <expression>IF({!IsRescheduled}=true, {!TEXT_RescheduledPrompt}, {!TEXT_PlannedOrReactivePrompt})</expression>
    </formulas>
    <formulas>
        <name>SiteContactNameFull</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!SiteContactNamesRemoveLastComma}, &quot;,&quot;), 
    SUBSTITUTE(
        LEFT({!SiteContactNamesRemoveLastComma}, FIND(&quot;,&quot;, {!SiteContactNamesRemoveLastComma}, LEN({!SiteContactNamesRemoveLastComma}) - LEN(SUBSTITUTE({!SiteContactNamesRemoveLastComma}, &quot;,&quot;, &quot;&quot;))) - 1), 
        &quot;,&quot;, 
        &quot; and &quot;
    ) &amp; MID({!SiteContactNamesRemoveLastComma}, FIND(&quot;,&quot;, {!SiteContactNamesRemoveLastComma}, LEN({!SiteContactNamesRemoveLastComma}) - LEN(SUBSTITUTE({!SiteContactNamesRemoveLastComma}, &quot;,&quot;, &quot;&quot;))) , LEN({!SiteContactNamesRemoveLastComma})), 
    {!SiteContactNamesRemoveLastComma}
)</expression>
    </formulas>
    <formulas>
        <name>SiteContactNamesRemoveLastComma</name>
        <dataType>String</dataType>
        <expression>IF(RIGHT({!PrimarySiteContactNames}, 1) = &quot;,&quot;,  LEFT({!PrimarySiteContactNames}, LEN({!PrimarySiteContactNames}) - 1), {!PrimarySiteContactNames})</expression>
    </formulas>
    <formulas>
        <name>TEXT_DateOfService</name>
        <dataType>String</dataType>
        <expression>CASE(MONTH({!DateOfService}),
  1, &quot;January&quot;,
  2, &quot;February&quot;,
  3, &quot;March&quot;,
  4, &quot;April&quot;,
  5, &quot;May&quot;,
  6, &quot;June&quot;,
  7, &quot;July&quot;,
  8, &quot;August&quot;,
  9, &quot;September&quot;,
  10, &quot;October&quot;,
  11, &quot;November&quot;,
  12, &quot;December&quot;,
  &quot;Error&quot;
)
&amp; &quot; &quot; &amp;
TEXT(DAY({!DateOfService}))
&amp; &quot;, &quot; &amp;
TEXT(YEAR({!DateOfService}))</expression>
    </formulas>
    <formulas>
        <name>TEXT_PlannedOrReactivePrompt</name>
        <dataType>String</dataType>
        <expression>&quot;scheduled a &quot; &amp; {!PlannedOrReactive} &amp; &quot; service at your site on &quot; &amp; {!TEXT_DateOfService} &amp; &quot; at &quot; &amp; {!$Record.ConvertEmailTimeToText__c} &amp; &quot; +/- 2 hour. We expect to have the LGen(s) down for approximately &quot; &amp; TEXT({!$Record.MS_FSM_Email_Service_Window__c})</expression>
    </formulas>
    <formulas>
        <name>TEXT_PriorDateOfService</name>
        <dataType>String</dataType>
        <expression>CASE(MONTH(DATEVALUE({!$Record__Prior.SchedStartTime})),
  1, &quot;January&quot;,
  2, &quot;February&quot;,
  3, &quot;March&quot;,
  4, &quot;April&quot;,
  5, &quot;May&quot;,
  6, &quot;June&quot;,
  7, &quot;July&quot;,
  8, &quot;August&quot;,
  9, &quot;September&quot;,
  10, &quot;October&quot;,
  11, &quot;November&quot;,
  12, &quot;December&quot;,
  &quot;Error&quot;
)
&amp; &quot; &quot; &amp;
TEXT(DAY(DATEVALUE({!$Record__Prior.SchedStartTime})))
&amp; &quot;, &quot; &amp;
TEXT(YEAR(DATEVALUE({!$Record__Prior.SchedStartTime})))</expression>
    </formulas>
    <formulas>
        <name>TEXT_RescheduledPrompt</name>
        <dataType>String</dataType>
        <expression>&quot;rescheduled a service at your site from &quot; &amp; {!TEXT_PriorDateOfService} &amp; &quot; to &quot; &amp; {!TEXT_DateOfService} &amp; &quot; at your site at &quot; &amp; {!$Record.ConvertEmailTimeToText__c}   &amp; &quot; for +/- 2 hour . We expect to have the LGen(s) down for approximately &quot; &amp; TEXT({!$Record.MS_FSM_Email_Service_Window__c})</expression>
    </formulas>
    <formulas>
        <name>TimeOfService</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS( TEXT({!$Record.SchedStartTime}) , &quot;, &quot;), 
    MID(TEXT({!$Record.SchedStartTime}), FIND(&quot;, &quot;, TEXT({!$Record.SchedStartTime})) + 2, LEN(TEXT({!$Record.SchedStartTime}))),
    TEXT({!$Record.SchedStartTime})
)</expression>
    </formulas>
    <formulas>
        <name>TimeOfTheService</name>
        <dataType>Number</dataType>
        <expression>VALUE( MID( TEXT( {!$Record.SchedStartTime} - 8/24 ), 12, 2 ) )</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>TodayDate</name>
        <dataType>String</dataType>
        <expression>TEXT(DATEVALUE({!$Record.SchedStartTime})) &amp; &quot;;&quot;</expression>
    </formulas>
    <formulas>
        <name>TodayNow</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TODAY())</expression>
    </formulas>
