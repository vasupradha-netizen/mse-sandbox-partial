<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>What_is_the_Application_State</name>
        <label>What is the Application State?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Initial_Review_Pending_or_Under_Review</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>StatusValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Under Review</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>StatusValue</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Status_Stage_to_Under_Review</targetReference>
            </connector>
            <label>Initial Review Pending/Under Review</label>
        </rules>
        <rules>
            <name>In_Progress_Stage_Update</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>StageValue</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>PendingVal</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>StatusValue</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Stage_to_Pending</targetReference>
            </connector>
            <label>In-Progress Stage Update</label>
        </rules>
        <rules>
            <name>Final_Approval</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>StatusValue</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>StatusValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Status_Stage_to_Approved</targetReference>
            </connector>
            <label>Final Approval</label>
        </rules>
        <rules>
            <name>Rejection</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>StatusValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>StageValue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Status_Stage_to_Rejected</targetReference>
            </connector>
            <label>Rejection</label>
        </rules>
    </decisions>
    <description>Subflow invoked by the Referral Partner Onboarding Approval Process to dynamically update a partner application&apos;s Status and Stage fields based on approval or rejection outcomes.</description>
    <environments>Default</environments>
    <interviewLabel>Update Partner Application Status {!$Flow.CurrentDateTime}</interviewLabel>
