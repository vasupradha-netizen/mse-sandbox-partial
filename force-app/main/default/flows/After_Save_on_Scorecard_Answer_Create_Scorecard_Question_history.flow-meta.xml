TEXT({!$Record.Answer_PL__c}) = &quot;True&quot;,
{!$Record.Scorecard_Question__r.Adder_Value__c},
IF(
TEXT({!$Record.Answer_PL__c}) = &quot;False&quot;,
{!$Record.Scorecard_Question__r.Subtractor_Value__c},
0))</expression>
