<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Service_Appointment_to_Collection</name>
        <label>Add Service Appointment to Collection</label>
        <locationX>578</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>ColTechSAsToCreate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>VAR_AdditionalTechSA</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Assign_Count_of_Collection_SAs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Count_of_Collection_SAs</name>
        <label>Assign Count of Collection SAs</label>
        <locationX>578</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>NumberofTechSAsinCollection</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>ColTechSAsToCreate</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Is_Number_of_Tech_SAs_Matching_Number_of_Techs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Service_Appointment_Values</name>
        <label>Assign Service Appointment Values</label>
        <locationX>578</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>VAR_AdditionalTechSA.ParentRecordId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Primary_Service_Appointment.ParentRecordId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_AdditionalTechSA.MS_FSM_Additional_Technician__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_AdditionalTechSA.EarliestStartTime</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Primary_Service_Appointment.EarliestStartTime</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_AdditionalTechSA.DueDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Primary_Service_Appointment.DueDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_AdditionalTechSA.ArrivalWindowStartTime</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Primary_Service_Appointment.ArrivalWindowStartTime</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_AdditionalTechSA.ArrivalWindowEndTime</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Primary_Service_Appointment.ArrivalWindowEndTime</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_AdditionalTechSA.Duration</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Primary_Service_Appointment.Duration</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_AdditionalTechSA.DurationType</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Primary_Service_Appointment.DurationType</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_AdditionalTechSA.MS_FSM_Primary_Appointment__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Primary_Service_Appointment.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Service_Appointment_to_Collection</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Are_there_Service_Appointments_to_Create</name>
        <label>Are there Service Appointments to Create</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_there_are_Service_Appointments_to_Create</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ColTechSAsToCreate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Service_Appointments</targetReference>
            </connector>
            <label>Yes there are Service Appointments to Create</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Number_of_Tech_SAs_Matching_Number_of_Techs</name>
        <label>Is Number of Tech SAs Matching Number of Techs</label>
        <locationX>380</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Assign_Service_Appointment_Values</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_they_match</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NumberofTechSAsinCollection</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>NumberOfTechs</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Are_there_Service_Appointments_to_Create</targetReference>
            </connector>
            <label>Yes, they match</label>
        </rules>
    </decisions>
    <description>Purpose of this Flow is to Create Additional Service Appointments, based on number of Technicians on a Work Order, in preparation of creating Dependencies between the Appointments.  This Flow is called from other Dependency Related Flows</description>
    <environments>Default</environments>
    <formulas>
        <name>ActualNumberofTechs</name>
        <dataType>Number</dataType>
        <expression>{!NumberOfTechs}-1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>MS_FSM_Subflow - Service Appointment After Save - Create Dependencies {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MS_FSM_Subflow - Service Appointment After Save - Create Dependencies</label>
    <processMetadataValues>
