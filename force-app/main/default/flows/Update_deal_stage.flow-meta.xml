    <decisions>
        <name>Date_Initiated</name>
        <label>Date Initiated</label>
        <locationX>182</locationX>
        <locationY>911</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_Date_initiated_is_blank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Date_Initiated__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Date_Initiated</targetReference>
            </connector>
            <label>If Date initiated is blank</label>
        </rules>
    </decisions>
    <decisions>
        <name>Update_Site_details</name>
        <label>Update Site details</label>
        <locationX>182</locationX>
        <locationY>503</locationY>
        <defaultConnector>
            <targetReference>Deal_Stage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_site_details_are_blank</name>
            <conditionLogic>1 AND (2 OR 3 OR 4 OR 5 OR 6 OR 7 OR 8)</conditionLogic>
            <conditions>
                <leftValueReference>isnew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Opportunity__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Street_1__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>$Record.State__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>$Record.City__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Gas_Utility__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Electric_Utility__c</leftValueReference>
                <operator>EqualTo</operator>
            </conditions>
            <connector>
                <targetReference>Update_missing_site_details</targetReference>
            </connector>
            <label>If site details are blank</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>DealStage</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!Get_Opportunity.StageName}, 
    &quot;Preliminary Meeting&quot;, &quot;Pre-Indicative Offer&quot;, 
&quot;Preliminary Discussions&quot;, &quot;Pre-Indicative Offer&quot;,
    &quot;Initial Assessment&quot;, &quot;Pre-Indicative Offer&quot;,
    &quot;Indicative Proposal&quot;, &quot;Indicative Offer&quot;, 
&quot;Proposal/RFP Generation&quot;, &quot;Indicative Offer&quot;,
    &quot;Firm Proposal&quot;, &quot;Firm Pricing&quot;,
&quot;Term Sheet&quot;, &quot;Firm Pricing&quot;,
    &quot;Closed won&quot;, &quot;Contracted&quot;,
    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>isnew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Update deal stage {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Project Assessment Deal Stage</label>
    <processMetadataValues>
