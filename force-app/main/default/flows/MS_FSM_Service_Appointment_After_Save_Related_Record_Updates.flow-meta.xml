    <formulas>
        <description>DST-aware UTC offset based on Service Territory operating hours timezone.</description>
        <name>OffsetFormula</name>
        <dataType>Number</dataType>
        <expression>CASE({!$Record.ServiceTerritory.OperatingHours.TimeZone},
  &quot;America/New_York&quot;,
    IF(AND(
      {!$Record.SchedStartTime} &gt;= DATETIMEVALUE(TEXT(YEAR(DATEVALUE({!$Record.SchedStartTime}))) &amp; &quot;-03-&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(8 + MOD(8 - WEEKDAY(DATE(YEAR(DATEVALUE({!$Record.SchedStartTime})),3,1)),7)),2) &amp; &quot; 07:00:00&quot;),
      {!$Record.SchedStartTime} &lt;  DATETIMEVALUE(TEXT(YEAR(DATEVALUE({!$Record.SchedStartTime}))) &amp; &quot;-11-&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(1 + MOD(8 - WEEKDAY(DATE(YEAR(DATEVALUE({!$Record.SchedStartTime})),11,1)),7)),2) &amp; &quot; 06:00:00&quot;)
    ), -4, -5),
  &quot;America/Chicago&quot;,
    IF(AND(
      {!$Record.SchedStartTime} &gt;= DATETIMEVALUE(TEXT(YEAR(DATEVALUE({!$Record.SchedStartTime}))) &amp; &quot;-03-&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(8 + MOD(8 - WEEKDAY(DATE(YEAR(DATEVALUE({!$Record.SchedStartTime})),3,1)),7)),2) &amp; &quot; 08:00:00&quot;),
      {!$Record.SchedStartTime} &lt;  DATETIMEVALUE(TEXT(YEAR(DATEVALUE({!$Record.SchedStartTime}))) &amp; &quot;-11-&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(1 + MOD(8 - WEEKDAY(DATE(YEAR(DATEVALUE({!$Record.SchedStartTime})),11,1)),7)),2) &amp; &quot; 07:00:00&quot;)
    ), -5, -6),
  &quot;America/Denver&quot;,
    IF(AND(
      {!$Record.SchedStartTime} &gt;= DATETIMEVALUE(TEXT(YEAR(DATEVALUE({!$Record.SchedStartTime}))) &amp; &quot;-03-&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(8 + MOD(8 - WEEKDAY(DATE(YEAR(DATEVALUE({!$Record.SchedStartTime})),3,1)),7)),2) &amp; &quot; 09:00:00&quot;),
      {!$Record.SchedStartTime} &lt;  DATETIMEVALUE(TEXT(YEAR(DATEVALUE({!$Record.SchedStartTime}))) &amp; &quot;-11-&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(1 + MOD(8 - WEEKDAY(DATE(YEAR(DATEVALUE({!$Record.SchedStartTime})),11,1)),7)),2) &amp; &quot; 08:00:00&quot;)
    ), -6, -7),
  &quot;America/Los_Angeles&quot;,
    IF(AND(
      {!$Record.SchedStartTime} &gt;= DATETIMEVALUE(TEXT(YEAR(DATEVALUE({!$Record.SchedStartTime}))) &amp; &quot;-03-&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(8 + MOD(8 - WEEKDAY(DATE(YEAR(DATEVALUE({!$Record.SchedStartTime})),3,1)),7)),2) &amp; &quot; 10:00:00&quot;),
      {!$Record.SchedStartTime} &lt;  DATETIMEVALUE(TEXT(YEAR(DATEVALUE({!$Record.SchedStartTime}))) &amp; &quot;-11-&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(1 + MOD(8 - WEEKDAY(DATE(YEAR(DATEVALUE({!$Record.SchedStartTime})),11,1)),7)),2) &amp; &quot; 09:00:00&quot;)
    ), -7, -8),
  &quot;America/Anchorage&quot;,
    IF(AND(
      {!$Record.SchedStartTime} &gt;= DATETIMEVALUE(TEXT(YEAR(DATEVALUE({!$Record.SchedStartTime}))) &amp; &quot;-03-&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(8 + MOD(8 - WEEKDAY(DATE(YEAR(DATEVALUE({!$Record.SchedStartTime})),3,1)),7)),2) &amp; &quot; 11:00:00&quot;),
      {!$Record.SchedStartTime} &lt;  DATETIMEVALUE(TEXT(YEAR(DATEVALUE({!$Record.SchedStartTime}))) &amp; &quot;-11-&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(1 + MOD(8 - WEEKDAY(DATE(YEAR(DATEVALUE({!$Record.SchedStartTime})),11,1)),7)),2) &amp; &quot; 10:00:00&quot;)
    ), -8, -9),
  &quot;America/Phoenix&quot;,   -7,
  &quot;Pacific/Honolulu&quot;, -10,
  0
)</expression>
        <scale>2</scale>
    </formulas>
