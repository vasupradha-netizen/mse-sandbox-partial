    <textTemplates>
        <description>Welcome email created just for FSM internal users in partial environment</description>
        <name>ForFsmInternalUsersPartial</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;Hello {!$Record.FirstName},&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-size: 14px; color: rgb(0, 0, 0); background-color: rgb(255, 255, 255);&quot;&gt;&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;&lt;/strong&gt;&lt;strong style=&quot;font-size: 14px; color: rgb(43, 44, 88); background-color: transparent;&quot;&gt;Welcome to &lt;/strong&gt;&lt;strong style=&quot;font-size: 14px; color: rgb(245, 62, 0); background-color: transparent;&quot;&gt;Mainspring Energy&apos;s &lt;/strong&gt;&lt;strong style=&quot;font-size: 14px; color: rgb(43, 44, 88); background-color: transparent;&quot;&gt;FSM on Salesforce!&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;To get started, please follow the following directions:&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent; color: rgb(0, 0, 0);&quot;&gt;Verify Salesforce Email - Subject: &quot;Welcome to Salesforce: Verify your account&quot;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Your username will be first.last@mainspringenergy.com.partial in &lt;/span&gt;&lt;a href=&quot;test.salesforce.com&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 14px;&quot;&gt;FSM Partial&lt;/a&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;When verifying your account, set-up your password.  &lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent;&quot;&gt;The second time you log in, you will be prompted to authenticate using your authenticator app.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent;&quot;&gt;If you are logging into mobile and having trouble, please visit the &lt;/span&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent; color: rgb(0, 0, 0);&quot;&gt; &lt;/span&gt;&lt;a href=&quot;https://docs.google.com/document/d/1lvKn5Lh96yHIwu3_gs_oZ-s6rIwsCNEthCWrGPveloI/edit?tab=t.0#bookmark=id.dgvvwuw5cvsf&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 14px;&quot;&gt;FSM Salesforce User Guide: FSM on Mobile&lt;/a&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; &lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;Need Help?&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px; color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;For Salesforce FSM Processes or Technical Support:&lt;/span&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent;&quot;&gt;Please slack &lt;/span&gt;&lt;a href=&quot;https://mainspringenergy.slack.com/messages/enterprise-and-fleet-operations/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 14px; color: rgb(17, 85, 204);&quot;&gt;&lt;u&gt;#enterprise-and-fleet-operations&lt;/u&gt;&lt;/a&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent;&quot;&gt; to reach us directly!&lt;/span&gt;&lt;strong style=&quot;font-size: 14px; background-color: transparent;&quot;&gt; &lt;/strong&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent;&quot;&gt;Don’t forget to tag @Kyle Reilly, @Kristin Elmstrom and @Anna Poon&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent;&quot;&gt;Additionally, please visit &lt;/span&gt;&lt;a href=&quot;https://help.salesforce.com/s/articleView?id=service.mfs_requirements.htm&amp;amp;type=5&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 14px; color: rgb(17, 85, 204);&quot;&gt;&lt;u&gt;Field Service Mobile App Requirements&lt;/u&gt;&lt;/a&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent;&quot;&gt; to ensure that all app requirements are met.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;Remember, users must follow Mainspring’s &lt;/span&gt;&lt;span style=&quot;font-size: 14px; color: rgb(77, 77, 79); background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;a href=&quot;https://app.drata.com/dashboard&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 14px;&quot;&gt;Acceptable Use Guidelines&lt;/a&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;font-size: 14px; color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;and&lt;/span&gt;&lt;span style=&quot;font-size: 14px; color: rgb(77, 77, 79); background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;a href=&quot;https://app.drata.com/dashboard&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 14px;&quot;&gt;Information Security Policy&lt;/a&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt; in the Drata Dashboard&lt;/span&gt;&lt;span style=&quot;font-size: 14px; color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;, including guidance on use of personal electronic devices for business purposes.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;Lastly, ​​​​​​for more information, please visit: &lt;/span&gt;&lt;a href=&quot;https://docs.google.com/document/d/1lvKn5Lh96yHIwu3_gs_oZ-s6rIwsCNEthCWrGPveloI/edit?tab=t.0&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 14px; color: rgb(17, 85, 204);&quot;&gt;&lt;u&gt;FSM Salesforce User Guide&lt;/u&gt;&lt;/a&gt;&lt;span style=&quot;font-size: 14px; color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;﻿Thank you and welcome onboard!&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;Best Regards,&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 14px; color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;Anna Poon&lt;/span&gt;&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <description>Welcome email created for FSM Salesforce users.</description>
        <name>ForFsmInternalUsersProduction</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;font-size: 14px; color: rgb(0, 0, 0); background-color: rgb(255, 255, 255);&quot;&gt;Hello {!$Record.FirstName},&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;background-color: rgb(255, 255, 255); color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;﻿&lt;/strong&gt;&lt;strong style=&quot;background-color: transparent; color: rgb(43, 44, 88); font-size: 14px;&quot;&gt;Welcome to &lt;/strong&gt;&lt;strong style=&quot;background-color: transparent; color: rgb(245, 62, 0); font-size: 14px;&quot;&gt;Mainspring Energy&apos;s &lt;/strong&gt;&lt;strong style=&quot;background-color: transparent; color: rgb(43, 44, 88); font-size: 14px;&quot;&gt;FSM on Salesforce, Field Service Team!&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;To get started, please follow the following directions:&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(0, 0, 0); background-color: transparent; font-size: 14px;&quot;&gt;Verify Salesforce Email - Subject: &quot;Welcome to Salesforce: Verify your account&quot;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;Login to &lt;/span&gt;&lt;a href=&quot;https://mainspringenergy2021.my.salesforce.com/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;Salesforce&lt;/a&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt; using &lt;/span&gt;&lt;a href=&quot;https://docs.google.com/document/d/1kNTPxJnRrSbfGk11nI80rTgHBzQYwWYS3ewcvdXbL5E/edit?tab=t.0&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;Single-Sign-On (SSO) through Jump Cloud&lt;/a&gt;&lt;ul&gt;&lt;li&gt;&lt;em style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;Note: &lt;/em&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;your username will be your Mainspring Energy email address&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;The second time you log in on FSM Desktop, you will be prompted to authenticate using your authenticator app.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;Technicians, if you are on a mobile device, you will need to use &lt;/span&gt;&lt;a href=&quot;https://docs.google.com/document/d/1kNTPxJnRrSbfGk11nI80rTgHBzQYwWYS3ewcvdXbL5E/edit?tab=t.0#bookmark=id.a9iuexq64au4&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;background-color: transparent; font-size: 14px; color: rgb(17, 85, 204);&quot;&gt;&lt;u&gt;Single-Sign-On (SSO) through the Field Service Mobile App&lt;/u&gt;&lt;/a&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;, please feel free to follow the instructions or watch this &lt;/span&gt;&lt;a href=&quot;https://drive.google.com/file/d/1nC5f9fJuE0hHpSyYU-CvElZx-676ebtP/view?usp=drive_link&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;How to Log In&lt;/a&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt; video on how to get help on how to sign on to production.&lt;/span&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px; color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;Before signing in, ensure you have a phone passcode set-up.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px; color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;Remember, to select the “Production” environment from the widget or three dots icon on the upper-right hand corner before signing in with SSO.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 14px; color: rgb(0, 0, 0); background-color: transparent;&quot;&gt;Additionally, remember to go to &quot;Use Custom Domain&quot; under the Log In button and enter &quot;mainspringenergy2021&quot;. This will guide you through JumpCloud for login.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(0, 0, 0); font-size: 14px; background-color: transparent;&quot;&gt;For more general information on set-up, please use&lt;/span&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;a href=&quot;https://docs.google.com/document/d/1lvKn5Lh96yHIwu3_gs_oZ-s6rIwsCNEthCWrGPveloI/edit?tab=t.0#bookmark=id.dgvvwuw5cvsf&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;font-size: 14px; color: rgb(17, 85, 204);&quot;&gt;&lt;u&gt;FSM Salesforce User Guide: FSM on Mobile&lt;/u&gt;&lt;/a&gt;&lt;span style=&quot;font-size: 14px; color: rgb(0, 0, 0); background-color: transparent;&quot;&gt; for more assistance.&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;Need Help?&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;For Salesforce FSM Processes or Technical Support:&lt;/span&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;Please slack &lt;/span&gt;&lt;a href=&quot;https://mainspringenergy.slack.com/messages/enterprise-and-fleet-operations/&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;background-color: transparent; font-size: 14px; color: rgb(17, 85, 204);&quot;&gt;&lt;u&gt;#enterprise-and-fleet-operations&lt;/u&gt;&lt;/a&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt; to reach us directly!&lt;/span&gt;&lt;strong style=&quot;background-color: transparent; font-size: 14px;&quot;&gt; &lt;/strong&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;Don’t forget to tag @Kyle Reilly, @eds-fleet-support for an EDS Team member to help!&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;Additionally, please visit &lt;/span&gt;&lt;a href=&quot;https://help.salesforce.com/s/articleView?id=service.mfs_requirements.htm&amp;amp;type=5&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;background-color: transparent; font-size: 14px; color: rgb(17, 85, 204);&quot;&gt;&lt;u&gt;Field Service Mobile App Requirements&lt;/u&gt;&lt;/a&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt; to ensure that all app requirements are met.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;Remember, users must follow Mainspring’s &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: rgb(77, 77, 79); font-size: 14px;&quot;&gt; &lt;/span&gt;&lt;a href=&quot;https://app.drata.com/dashboard&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;background-color: rgb(255, 255, 255); font-size: 14px;&quot;&gt;Acceptable Use Guidelines&lt;/a&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 14px; color: rgb(68, 68, 68);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px; color: rgb(0, 0, 0);&quot;&gt;and&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px; color: rgb(77, 77, 79);&quot;&gt; &lt;/span&gt;&lt;a href=&quot;https://app.drata.com/dashboard&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;background-color: rgb(255, 255, 255); font-size: 14px;&quot;&gt;Information Security Policy&lt;/a&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); font-size: 14px; color: rgb(0, 0, 0);&quot;&gt; in the Drata Dashboard&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px; color: rgb(0, 0, 0);&quot;&gt;, including guidance on use of personal electronic devices for business purposes.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;Lastly, ​​​​​​for more information, please visit: &lt;/span&gt;&lt;a href=&quot;https://docs.google.com/document/d/1lvKn5Lh96yHIwu3_gs_oZ-s6rIwsCNEthCWrGPveloI/edit?tab=t.0&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot; style=&quot;background-color: transparent; color: rgb(17, 85, 204); font-size: 14px;&quot;&gt;&lt;u&gt;FSM Salesforce User Guide&lt;/u&gt;&lt;/a&gt;&lt;span style=&quot;background-color: transparent; color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;.&amp;nbsp;Thank you and welcome onboard!&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;Best Regards,&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: rgb(0, 0, 0); font-size: 14px;&quot;&gt;Anna Poon&lt;/span&gt;&lt;/p&gt;</text>
    </textTemplates>
