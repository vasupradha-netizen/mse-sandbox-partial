            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_ServiceAppointment.ActualEndTime</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Actual_End</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Service_Appointment</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Was_a_Service_Appointment_Found</name>
        <label>Was a Service Appointment Found</label>
        <locationX>182</locationX>
        <locationY>866</locationY>
        <defaultConnector>
            <targetReference>Service_Appointment_not_Found</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_a_Service_Appointment_was_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>VAR_ServiceAppointment.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Actual_Times</targetReference>
            </connector>
            <label>Yes, a Service Appointment was found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_a_Work_Order_Found_from_Direct_Field</name>
        <label>Was a Work Order Found from Direct Field</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Get_Work_Order_from_Parent_Field</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_a_Work_Order_was_found_from_a_Direct_Field</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_WorkOrder.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Service_Appointment</targetReference>
            </connector>
            <label>Yes, a Work Order was found from a Direct Field</label>
        </rules>
    </decisions>
    <description>Purpose of this Flow is to provide the Mobile User the Ability to override Actual Start/End Times that were captured automatically as part of the job moving through various Status Changes</description>
    <environments>Default</environments>
    <interviewLabel>MS_FSM_SFS Mobile - Override Actual times {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MS_FSM_SFS Mobile - Override Actual times</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
