<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_values_for_new_case</name>
        <label>Set values for new case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>VAR_CaseForDateParked.Description</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Parked Asset</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_CaseForDateParked.AssetId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_CaseForDateParked.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Problem</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_CaseForDateParked.Reason</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Unexpected behavior</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_CaseForDateParked.Origin</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Internal</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_CaseForDateParked.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>00GQr00000OwpihMAB</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_CaseForDateParked.Subject</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.MS_FSM_Reason_Parked_RTF__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_a_Case</targetReference>
        </connector>
    </assignments>
    <description>Creates case whenever there date on a parked core (L2 only)</description>
    <environments>Default</environments>
    <interviewLabel>MS FSM Create Case for Missing Date on Parked Lgen {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MS FSM Create Case for Missing Date on Parked Lgen</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>The status is parked but there is no date</description>
        <name>Create_a_Case</name>
        <label>Create a Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>VAR_CaseForDateParked</inputReference>
    </recordCreates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_values_for_new_case</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Parked</stringValue>
            </value>
        </filters>
        <filters>
            <field>MS_FSM_Date_Parked__c</field>
            <operator>NotEqualTo</operator>
        </filters>
        <filters>
            <field>MS_FSM_Asset_Level_Number__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>2</stringValue>
            </value>
        </filters>
        <object>Asset</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>VAR_CaseForDateParked</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
</Flow>
