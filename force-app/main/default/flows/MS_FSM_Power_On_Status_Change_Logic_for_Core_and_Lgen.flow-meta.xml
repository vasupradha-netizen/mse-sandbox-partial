<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_to_Count_of_Cores_Parked</name>
        <label>Add to Count of Cores Parked</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>CountOfParkedCores</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Count_cores_that_are_in_parked_status</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Package_Status_to_Reduced_Power</name>
        <label>Assign Package Status to Reduced Power</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>VAR_Package.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Reduced Power</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_Package.MS_FSM_Date_Parked__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_Package.MS_FSM_Reason_Parked_RTF__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <connector>
            <targetReference>Update_package_with_new_status</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Package_Status_to_Running</name>
        <label>Assign Package Status to Running</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>VAR_Package.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Installed</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_Package.MS_FSM_Date_Parked__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>VAR_Package.MS_FSM_Reason_Parked_RTF__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <connector>
            <targetReference>Update_package_with_new_status</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Core_Status_to_Parked</name>
        <label>Set Core Status to Parked</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Assign_new_status_of_parked_on_all_cores.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Installed</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Assign_new_status_of_parked_on_all_cores.MS_FSM_Date_Parked__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Assign_new_status_of_parked_on_all_cores.MS_FSM_Reason_Parked_RTF__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <connector>
            <targetReference>Update_core_record_with_parked_status</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Core_is_Parked</name>
        <label>Core is Parked</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Count_cores_that_are_in_parked_status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Core_in_loop_is_parked</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Count_cores_that_are_in_parked_status.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Parked</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_to_Count_of_Cores_Parked</targetReference>
            </connector>
            <label>Core in loop is parked</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_asset_is_a_core</name>
        <label>If asset is a core</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No, not core</defaultConnectorLabel>
        <rules>
            <name>Yes_Product_Family_is_a_Core</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ProductFamily</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core A</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ProductFamily</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Core B</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Count_cores_that_are_in_parked_status</targetReference>
            </connector>
            <label>Yes, Product Family is a Core</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_asset_is_a_package</name>
        <label>If asset is a package</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Was_this_change_triggered_from_a_package</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No, not package</defaultConnectorLabel>
        <rules>
            <name>Yes_Product_Family_Package</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ProductFamily</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MSE 3</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ProductFamily</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Package</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_Status_Running</targetReference>
            </connector>
            <label>Yes, Product Family Package</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Status_Running</name>
        <label>Is Status Running</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default, do nothing</defaultConnectorLabel>
        <rules>
            <name>Status_is_Running</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Installed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_new_status_of_parked_on_all_cores</targetReference>
            </connector>
            <label>Status is Running</label>
        </rules>
    </decisions>
    <decisions>
        <name>Should_package_be_in_Reduced_Power_or_Running_Status</name>
        <label>Should package be in Reduced Power or Running Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_package_with_new_status</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No change</defaultConnectorLabel>
        <rules>
            <name>Count_of_parked_cores_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CountOfParkedCores</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Package_Status_to_Reduced_Power</targetReference>
            </connector>
            <label>Count of parked cores 1</label>
        </rules>
        <rules>
            <name>Count_of_parked_cores_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CountOfParkedCores</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Package_Status_to_Running</targetReference>
            </connector>
            <label>Count of parked cores 0</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_this_change_triggered_from_a_package</name>
        <label>Was this change triggered from a package?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No_this_was_not_triggered_from_a_package</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>VAR_Package.MS_FSM_Previous_Asset_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Parked</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>VAR_Package.MS_FSM_Previous_Asset_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Third-Party Outage</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Installed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>If_asset_is_a_core</targetReference>
            </connector>
            <label>No, this was not triggered from a package</label>
        </rules>
    </decisions>
    <description>Logic to trigger statuses of Core and Lgen to Power back on from &quot;Parked&quot; or &quot;Third-Party&quot;</description>
    <environments>Default</environments>
    <formulas>
        <name>ReadCoreAssetStatus</name>
        <dataType>String</dataType>
        <expression>{!VAR_CoreAssetHistory.OldValue}</expression>
    </formulas>
    <formulas>
        <name>ReadPackageAssetStatus</name>
        <dataType>String</dataType>
        <expression>{!VAR_PackageAssetHistory.OldValue}</expression>
    </formulas>
    <interviewLabel>MS_FSM Power On Status Change Logic for Core and Lgen {!$Flow.CurrentDateTime}</interviewLabel>
    <label>MS_FSM Power On Status Change Logic for Core and Lgen</label>
    <loops>
        <name>Assign_new_status_of_parked_on_all_cores</name>
        <label>Assign new status of parked on all cores</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>VAR_Cores_Collection</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Set_Core_Status_to_Parked</targetReference>
        </nextValueConnector>
    </loops>
    <loops>
        <name>Count_cores_that_are_in_parked_status</name>
        <label>Count cores that are in parked status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>VAR_Cores_Collection</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Core_is_Parked</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Should_package_be_in_Reduced_Power_or_Running_Status</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Lgen_Cores</name>
        <label>Get Lgen Cores</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Lgen_Package</targetReference>
        </connector>
        <filterLogic>1 AND (2  OR 3)</filterLogic>
        <filters>
            <field>RootAssetId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.RootAssetId</elementReference>
            </value>
        </filters>
        <filters>
            <field>ProductFamily</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Core A</stringValue>
            </value>
        </filters>
        <filters>
            <field>ProductFamily</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Core B</stringValue>
            </value>
        </filters>
        <object>Asset</object>
        <outputReference>VAR_Cores_Collection</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Status</queriedFields>
        <queriedFields>MS_FSM_Previous_Asset_Status__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Lgen_Package</name>
        <label>Get Lgen Package</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>If_asset_is_a_package</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RootAssetId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.RootAssetId</elementReference>
            </value>
        </filters>
        <filters>
            <field>ProductFamily</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Package</stringValue>
            </value>
        </filters>
        <object>Asset</object>
        <outputReference>VAR_Package</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Status</queriedFields>
        <queriedFields>MS_FSM_Previous_Asset_Status__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <description>Get root asset associated to find the cores or packages needed</description>
        <name>Get_Root_Asset_to_find_Cores_Package</name>
        <label>Get Root Asset to find Cores/Package</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Lgen_Cores</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.RootAssetId</elementReference>
            </value>
        </filters>
        <object>Asset</object>
        <outputReference>VAR_RootAsset</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Status</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_core_record_with_parked_status</name>
        <label>Update core record with parked status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Assign_new_status_of_parked_on_all_cores</targetReference>
        </connector>
        <inputReference>Assign_new_status_of_parked_on_all_cores</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_package_with_new_status</name>
        <label>Update package with new status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>VAR_Package</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Root_Asset_to_find_Cores_Package</targetReference>
        </connector>
        <filterLogic>((1 OR 2 OR 3 OR 4) OR (1 OR 2)) AND (5 AND 6 AND 7 AND (8 OR 9))</filterLogic>
        <filters>
            <field>ProductFamily</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>MSE 3</stringValue>
            </value>
        </filters>
        <filters>
            <field>ProductFamily</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Package</stringValue>
            </value>
        </filters>
        <filters>
            <field>ProductFamily</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Core A</stringValue>
            </value>
        </filters>
        <filters>
            <field>ProductFamily</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Core B</stringValue>
            </value>
        </filters>
        <filters>
            <field>MS_FSM_Asset_Level_Number__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>2</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Installed</stringValue>
            </value>
        </filters>
        <filters>
            <field>MS_FSM_Previous_Asset_Status__c</field>
            <operator>EqualTo</operator>
        </filters>
        <filters>
            <field>MS_FSM_Previous_Asset_Status__c</field>
            <operator>EqualTo</operator>
        </filters>
        <object>Asset</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>CountOfParkedCores</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>VAR_CoreAssetHistory</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>AssetHistory</objectType>
    </variables>
    <variables>
        <name>VAR_Cores_Collection</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Asset</objectType>
    </variables>
    <variables>
        <name>VAR_CoreStatuses</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>AssetHistory</objectType>
    </variables>
    <variables>
        <name>VAR_Package</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Asset</objectType>
    </variables>
    <variables>
        <name>VAR_PackageAssetHistory</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>AssetHistory</objectType>
    </variables>
    <variables>
        <name>VAR_RootAsset</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Asset</objectType>
    </variables>
</Flow>
