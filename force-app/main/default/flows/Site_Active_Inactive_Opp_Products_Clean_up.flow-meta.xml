<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Active_Sales_Changed</name>
        <label>Active Sales Changed?</label>
        <locationX>644</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Inactive</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Active_Sale__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Number_of_Units_on_Opportunity</targetReference>
            </connector>
            <label>Inactive</label>
        </rules>
        <rules>
            <name>Active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Active_Sale__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_LGEN_Prod_Present</targetReference>
            </connector>
            <label>Active</label>
        </rules>
    </decisions>
    <decisions>
        <name>Any_Products_to_Delete</name>
        <label>Any Products to Delete?</label>
        <locationX>182</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetAllProductsForSite</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_Opp_Products</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>If yes, proceed  
If no LGEN product present, don&apos;t re-create products upon activation</description>
        <name>Is_LGEN_Prod_Present</name>
        <label>Is LGEN Prod Present?</label>
        <locationX>710</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_LGEN_Product_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.LGen_Model_Prod_ID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Re_create_Opp_Prods</targetReference>
            </connector>
            <label>Yes - LGEN Product Present</label>
        </rules>
    </decisions>
    <description>When a Site is marked Inactive -&gt; delete all related Opp Products and decrease Number of Units
When a Site is marked active -&gt; re-create all related Opp Products</description>
    <environments>Default</environments>
    <formulas>
        <name>NewOppNumberofUnits</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Opportunity__r.Number_of_Units__c}-{!$Record.Number_of_Units__c}</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Site - Active/Inactive Opp Products Clean up {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Site - Active/Inactive Opp Products Clean up</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordDeletes>
        <name>Delete_Opp_Products</name>
        <label>Delete Opp Products</label>
        <locationX>50</locationX>
        <locationY>755</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Site__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <object>OpportunityLineItem</object>
    </recordDeletes>
    <recordLookups>
        <name>GetAllProductsForSite</name>
        <label>GetAllProductsForSite</label>
        <locationX>182</locationX>
        <locationY>539</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Any_Products_to_Delete</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Site__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OpportunityLineItem</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Number_of_Units_on_Opportunity</name>
        <label>Update Number of Units on Opportunity</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <connector>
            <targetReference>GetAllProductsForSite</targetReference>
        </connector>
        <inputAssignments>
            <field>Number_of_Units__c</field>
            <value>
                <elementReference>$Record.Opportunity__r.Number_of_Units__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>518</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Active_Sales_Changed</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Active_Sale__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Sites__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Re_create_Opp_Prods</name>
        <label>Re-create Opp Prods</label>
        <locationX>578</locationX>
        <locationY>539</locationY>
        <flowName>Create_Opportunity_Prods_For_Site</flowName>
        <inputAssignments>
            <name>EPC_Needed</name>
            <value>
                <elementReference>$Record.EPC_Services_Needed__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>EPC_Price</name>
            <value>
                <elementReference>$Record.EPC_Services_Price__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>Hardware_price_per_kW_for_this_site</name>
            <value>
                <elementReference>$Record.Hardware_Price_per_kW__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>HydrogenKitNeeded</name>
            <value>
                <elementReference>$Record.Hydrogen_Kit__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>LGEN_Model_For_This_Site</name>
            <value>
                <elementReference>$Record.LGen_Model_Prod_ID__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>NumberOfUnitsAtSite</name>
            <value>
                <elementReference>$Record.Number_of_Units__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>OppId</name>
            <value>
                <elementReference>$Record.Opportunity__r.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>SiteId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
</Flow>
