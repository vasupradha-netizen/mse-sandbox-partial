<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_to_Coll</name>
        <label>Add to Coll</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>SCAColl</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>SCASingle</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Scorecard_Answers</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_SCA_Single</name>
        <label>Assign SCA Single</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>SCASingle.Scorecard_Question__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_Scorecard_Answers.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SCASingle.Question_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_Scorecard_Answers.Question_Type__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SCASingle.Question_Name__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_Scorecard_Answers.Title__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SCASingle.Order_Number__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_Scorecard_Answers.Order_number__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SCASingle.Possible_Point_Value__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_Scorecard_Answers.Adder_Value__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SCASingle.Opportunity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>SCASingle.Account__c</assignToReference>
