    <formulas>
        <name>setDescription</name>
        <dataType>String</dataType>
        <expression>&quot;This account became an MQA on &quot; &amp;
TEXT(DATEVALUE(NOW()-(8/24))) &amp; &quot; &quot; &amp;
TEXT(
  IF(
    MOD(HOUR(TIMEVALUE(NOW()-(8/24))), 12) = 0,
    12,
    MOD(HOUR(TIMEVALUE(NOW()-(8/24))), 12)
  )
) &amp; &quot;:&quot; &amp;
RIGHT(
  &quot;0&quot; &amp; TEXT(MINUTE(TIMEVALUE(NOW()-(8/24)))),
  2
) &amp; &quot; &quot; &amp;
IF(
  HOUR(TIMEVALUE(NOW()-(8/24))) &gt;= 12,
  &quot;PM&quot;,
  &quot;AM&quot;
) &amp;
&quot;. You have until &quot; &amp;
TEXT(DATEVALUE(NOW()+1-(8/24))) &amp; &quot; &quot; &amp;
TEXT(
  IF(
    MOD(HOUR(TIMEVALUE(NOW()+1-(8/24))), 12) = 0,
    12,
    MOD(HOUR(TIMEVALUE(NOW()+1-(8/24))), 12)
  )
) &amp; &quot;:&quot; &amp;
RIGHT(
  &quot;0&quot; &amp; TEXT(MINUTE(TIMEVALUE(NOW()+1-(8/24)))),
  2
) &amp; &quot; &quot; &amp;
IF(
  HOUR(TIMEVALUE(NOW()+1-(8/24))) &gt;= 12,
  &quot;PM&quot;,
  &quot;AM&quot;
) &amp;
&quot; to reach out.&quot;</expression>
    </formulas>
