    @isTest
    private static void testUpdateOfficialsLowerState(){
       //create Site
       Opportunity opp = new Opportunity(Name ='Test', StageName = 'Initial Assessment', CloseDate=date.today()); 
       insert opp;
       Sites__c site = new Sites__c(Opportunity__c=opp.Id, Name='Test Site', Street_1__c='615 7th Ave',
                                       City__c='Santa Cruz', State_Region__c='California', Postal_Code__c='95062');
       insert site;
       Contact existingContact = new Contact(FirstName='Dawn', LastName='Addis', Role__c='Legislator', District_Type__c='State House');
       insert existingContact;
       Test.setMock(HttpCalloutMock.class, new MainspringCiceroMockImpl(jsonLowerState));
       test.startTest();
        MainspringCiceroUtility.updateOfficialsInvocable(new List<String>{site.id});
       test.stopTest();
       List<Sites__c> sites = [select Id, US_Senate_1__c, US_Senate_1__r.FirstName, US_Senate_1__r.LastName,  
                            US_Senate_2__c, US_Senate_2__r.FirstName, US_Senate_2__r.LastName, 
                            US_House__c, US_House__r.FirstName,
                            State_Senate__c, State_Senate__r.FirstName,
                            State_House__c, State_House__r.FirstName
                            from Sites__c where id =:site.id];
        System.assertNotEquals(null, sites[0].State_House__c);                    
    }

