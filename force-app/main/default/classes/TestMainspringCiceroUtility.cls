    @isTest
    private static void testErrorResponseBadAddress() {
       //create Site
       Opportunity opp = new Opportunity(Name ='Test', StageName = 'Initial Assessment', CloseDate=date.today()); 
       insert opp;
       Sites__c site = new Sites__c(Opportunity__c=opp.Id, Name='Test Site', Street_1__c='Bad Address',
                                       City__c='Santa Cruz', State_Region__c='California', Postal_Code__c='95062');
       insert site;
       Test.setMock(HttpCalloutMock.class, new MainspringCiceroMockImpl(jsonError));
       test.startTest();
        MainspringCiceroFlowUtility.updateOfficialsClearLookupsInvocable(new List<String>{site.id});
       test.stopTest();
       List<Sites__c> sites = [select Id, US_Senate_1__c, US_Senate_2__c, 
                            US_House__c,State_Senate__c, State_House__c, 
                            Cicero_API_Call_Response__c, Cicero_API_Call_Last_Refresh__c
                            from Sites__c where id =:site.id];                 
        System.assertEquals(null, sites[0].US_Senate_1__c);  
        System.assertEquals(null, sites[0].US_Senate_2__c);  
        System.assertEquals(null, sites[0].US_House__c);  
        System.assertEquals(null, sites[0].State_Senate__c);  
        System.assertEquals(null, sites[0].State_House__c); 
        System.assertEquals('No geocoding results found for address', sites[0].Cicero_API_Call_Response__c); 
        System.assertNotEquals(null, sites[0].Cicero_API_Call_Last_Refresh__c);
    }
